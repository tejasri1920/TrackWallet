      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "tx_type_valid": {
          "name": "tx_type_valid",
          "value": "\"transactions\".\"type\" IN ('income','expense','transfer')"
        },
        "tx_expense_shape": {
          "name": "tx_expense_shape",
          "value": "\"transactions\".\"type\" <> 'expense' OR (\"transactions\".\"amount_native\" < 0 AND \"transactions\".\"category_id\" IS NOT NULL)"
        },
        "tx_income_shape": {
          "name": "tx_income_shape",
          "value": "\"transactions\".\"type\" <> 'income' OR (\"transactions\".\"amount_native\" > 0 AND \"transactions\".\"category_id\" IS NOT NULL)"
        },
        "tx_transfer_shape": {
          "name": "tx_transfer_shape",
          "value": "\"transactions\".\"type\" <> 'transfer' OR (\"transactions\".\"category_id\" IS NULL AND \"transactions\".\"transfer_group_id\" IS NOT NULL)"
        },
        "tx_usd_rate": {
          "name": "tx_usd_rate",
          "value": "\"transactions\".\"currency\" <> 'USD' OR (\"transactions\".\"amount_native\" = \"transactions\".\"amount_usd\" AND \"transactions\".\"fx_rate\" = 1.0)"
        },
        "tx_foreign_rate": {
          "name": "tx_foreign_rate",
          "value": "\"transactions\".\"currency\" = 'USD' OR (\"transactions\".\"fx_rate\" > 0 AND ABS(ABS(\"transactions\".\"amount_native\") / \"transactions\".\"fx_rate\" - ABS(\"transactions\".\"amount_usd\")) <= 1)"
        },
        "tx_sign_match": {
          "name": "tx_sign_match",
          "value": "(\"transactions\".\"amount_native\" > 0 AND \"transactions\".\"amount_usd\" > 0) OR (\"transactions\".\"amount_native\" < 0 AND \"transactions\".\"amount_usd\" < 0) OR (\"transactions\".\"amount_native\" = 0 AND \"transactions\".\"amount_usd\" = 0)"
        },
        "tx_money_integer": {
          "name": "tx_money_integer",
          "value": "typeof(\"transactions\".\"amount_native\") = 'integer' AND typeof(\"transactions\".\"amount_usd\") = 'integer'"
        },
        "tx_fx_numeric": {
          "name": "tx_fx_numeric",
          "value": "typeof(\"transactions\".\"fx_rate\") IN ('real','integer')"
        },
        "tx_currency_format": {
          "name": "tx_currency_format",
          "value": "\"transactions\".\"currency\" GLOB '[A-Z][A-Z][A-Z]'"
        },
        "tx_group_only_on_transfer": {
          "name": "tx_group_only_on_transfer",
          "value": "\"transactions\".\"transfer_group_id\" IS NULL OR \"transactions\".\"type\" = 'transfer'"
        },
        "tx_transfer_nonzero": {
          "name": "tx_transfer_nonzero",
          "value": "\"transactions\".\"type\" <> 'transfer' OR \"transactions\".\"amount_native\" <> 0"
        }
      }
